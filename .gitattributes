# Normalize text source and documentation without changing binary research assets
* text=auto
*.py text eol=lf
*.ipynb text eol=lf
*.md text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=crlf
*.png binary
*.jpg binary
*.jpeg binary
*.xlsx binary
*.zip binary
*.pt binary
*.pth binary
